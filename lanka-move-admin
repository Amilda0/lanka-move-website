<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lanka Move | Ride & Delivery</title>

<style>
:root {
  --blue: #0755d9;
  --dark: #10264a;
  --light: #f3f7ff;
  --white: #ffffff;
  --muted: #687891;
  --border: #dfe7f2;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--light);
  color: var(--dark);
}

header {
  background: var(--white);
  padding: 16px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  box-shadow: 0 3px 15px #10264a0d;
}

.logo {
  color: var(--blue);
  font-size: 25px;
  font-weight: 800;
  white-space: nowrap;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

nav a {
  color: var(--dark);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
}

nav a:hover {
  color: var(--blue);
}

.hero {
  padding: 55px 6% 45px;
  background: linear-gradient(135deg, #0755d9, #168df5);
  color: white;
}

.hero-inner {
  max-width: 1100px;
  margin: auto;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 30px;
  align-items: center;
}

.badge {
  display: inline-block;
  padding: 8px 12px;
  background: #ffffff22;
  border: 1px solid #ffffff55;
  border-radius: 30px;
  font-size: 13px;
}

.hero h1 {
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.12;
  margin: 18px 0;
}

.hero p {
  line-height: 1.7;
  font-size: 16px;
  max-width: 520px;
  color: #edf5ff;
}

.hero-card {
  background: white;
  color: var(--dark);
  padding: 25px;
  border-radius: 22px;
  box-shadow: 0 15px 40px #00245d30;
}

.hero-card .big-icon {
  font-size: 68px;
  text-align: center;
  margin: 5px 0 12px;
}

.hero-card h2 {
  text-align: center;
  margin: 5px 0;
}

.hero-card p {
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

.container {
  max-width: 1100px;
  margin: auto;
  padding: 35px 20px;
}

.section-title {
  text-align: center;
  font-size: 28px;
  margin: 0 0 10px;
}

.section-subtitle {
  text-align: center;
  color: var(--muted);
  line-height: 1.6;
  margin: 0 auto 25px;
}

.services {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.service {
  background: white;
  border: 2px solid transparent;
  border-radius: 18px;
  padding: 24px 18px;
  cursor: pointer;
  box-shadow: 0 5px 20px #10264a08;
  transition: 0.2s;
}

.service:hover {
  transform: translateY(-3px);
}

.service.selected {
  border-color: var(--blue);
  background: #f0f6ff;
}

.service-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  background: #e9f1ff;
  border-radius: 16px;
  font-size: 30px;
}

.service h3 {
  margin: 16px 0 8px;
}

.service p {
  color: var(--muted);
  line-height: 1.5;
  font-size: 14px;
  margin-bottom: 0;
}

.booking-section {
  background: #eaf1ff;
  padding: 15px 20px 45px;
}

.booking {
  max-width: 650px;
  margin: 25px auto 0;
  background: white;
  padding: 28px;
  border-radius: 20px;
  box-shadow: 0 8px 30px #10264a0b;
}

.booking h2 {
  margin-top: 0;
}

.field {
  margin-top: 17px;
}

label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
}

input, select {
  width: 100%;
  min-height: 49px;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px;
  background: white;
  color: var(--dark);
  font-size: 16px;
}

input:focus, select:focus {
  outline: 2px solid #b9d2ff;
  border-color: var(--blue);
}

.primary-button {
  width: 100%;
  min-height: 51px;
  margin-top: 22px;
  border: none;
  border-radius: 11px;
  background: var(--blue);
  color: white;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.primary-button:hover {
  background: #0645b1;
}

.notice {
  padding: 12px;
  border-radius: 10px;
  background: #fff8e6;
  color: #765300;
  font-size: 13px;
  line-height: 1.6;
}

#message {
  line-height: 1.5;
  font-size: 14px;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  text-align: center;
}

.feature {
  background: white;
  padding: 22px 12px;
  border-radius: 15px;
}

.feature span {
  font-size: 30px;
}

.feature h3 {
  font-size: 16px;
}

.feature p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.5;
}

footer {
  padding: 28px 20px;
  background: #0b2042;
  color: white;
  text-align: center;
  line-height: 1.8;
  font-size: 14px;
}

footer p {
  margin: 4px;
}

@media (max-width: 700px) {
  header {
    padding: 15px 18px;
    flex-wrap: wrap;
  }

  .logo {
    font-size: 22px;
  }

  nav {
    width: 100%;
    justify-content: space-between;
    gap: 10px;
  }

  nav a {
    font-size: 13px;
  }

  .hero {
    padding: 35px 20px;
  }

  .hero-inner {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .hero h1 {
    font-size: 35px;
  }

  .hero-card {
    padding: 20px;
  }

  .hero-card .big-icon {
    font-size: 54px;
  }

  .container {
    padding: 30px 16px;
  }

  .section-title {
    font-size: 24px;
  }

  .services {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .service {
    display: grid;
    grid-template-columns: 58px 1fr;
    column-gap: 14px;
    align-items: center;
    padding: 17px;
  }

  .service-icon {
    grid-row: 1 / span 2;
  }

  .service h3 {
    margin: 0 0 5px;
  }

  .service p {
    margin: 0;
  }

  .booking-section {
    padding: 10px 12px 35px;
  }

  .booking {
    padding: 21px 16px;
  }

  .features {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .feature {
    padding: 18px;
  }
}

@media (max-width: 360px) {
  .hero h1 {
    font-size: 29px;
  }

  nav a {
    font-size: 12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🚕 Lanka Move</div>
  <nav>
    <a href="#services">Services</a>
    <a href="#booking">Book a Ride</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-inner">
    <div>
      <span class="badge">🇱🇰 Your local travel partner</span>
      <h1>Every Journey<br>Starts with Us.</h1>
      <p>Book a bike ride, car journey or delivery service through Lanka Move. Simple, convenient travel across Sri Lanka.</p>
    </div>

    <div class="hero-card">
      <div class="big-icon">🏍️ 🚗</div>
      <h2>Where would you like to go?</h2>
      <p>Choose your service and enter your trip details below.</p>
      <button class="primary-button" onclick="document.getElementById('booking').scrollIntoView({behavior:'smooth'})">
        Get Started →
      </button>
    </div>
  </div>
</section>

<section class="container" id="services">
  <h2 class="section-title">Choose Your Service</h2>
  <p class="section-subtitle">A convenient option for your journey or delivery.</p>

  <div class="services">
    <div class="service selected" onclick="chooseService('Bike Taxi', this)">
      <div class="service-icon">🏍️</div>
      <h3>Bike Taxi</h3>
      <p>Quick and convenient rides for everyday travel.</p>
    </div>

    <div class="service" onclick="chooseService('Car Taxi', this)">
      <div class="service-icon">🚗</div>
      <h3>Car Taxi</h3>
      <p>Comfortable travel for you and your family.</p>
    </div>

    <div class="service" onclick="chooseService('Delivery', this)">
      <div class="service-icon">📦</div>
      <h3>Delivery</h3>
      <p>Send parcels and items to their destination.</p>
    </div>
  </div>
</section>

<section class="booking-section" id="booking">
  <div class="container">
    <h2 class="section-title">Plan Your Trip</h2>
    <p class="section-subtitle">Enter your details to preview a booking request.</p>

    <div class="booking">
      <div class="notice">
        Demo version: this form does not send a real booking yet. We will connect the database and driver system in a later step.
      </div>

      <form onsubmit="showDemoMessage(event)">
        <div class="field">
          <label for="service">Service Type</label>
          <select id="service" required>
            <option>Bike Taxi</option>
            <option>Car Taxi</option>
            <option>Delivery</option>
          </select>
        </div>

        <div class="field">
          <label for="pickup">Pickup Location</label>
          <input id="pickup" type="text" placeholder="Where should we pick you up?" required>
        </div>

        <div class="field">
          <label for="destination">Destination</label>
          <input id="destination" type="text" placeholder="Where are you going?" required>
        </div>

        <div class="field">
          <label for="phone">Phone Number</label>
          <input id="phone" type="tel" placeholder="+94 77 123 4567"
                 pattern="^\+?[0-9 ]{9,15}$" required>
        </div>

        <button class="primary-button" type="submit">Continue →</button>
        <p id="message" role="status"></p>
      </form>
    </div>
  </div>
</section>

<section class="container">
  <h2 class="section-title">Why Lanka Move?</h2>
  <p class="section-subtitle">Designed to make everyday journeys easier.</p>

  <div class="features">
    <div class="feature">
      <span>📱</span>
      <h3>Easy to Use</h3>
      <p>A simple experience on mobile and desktop.</p>
    </div>

    <div class="feature">
      <span>🛵</span>
      <h3>Multiple Services</h3>
      <p>Choose a ride or request a delivery.</p>
    </div>

    <div class="feature">
      <span>🇱🇰</span>
      <h3>Made for Sri Lanka</h3>
      <p>A local service concept for Sri Lankan journeys.</p>
    </div>
  </div>
</section>

<footer>
  <p><strong>🚕 Lanka Move</strong></p>
  <p>Ride & Delivery Service · Sri Lanka 🇱🇰</p>
  <p>© 2026 Lanka Move. All rights reserved.</p>
</footer>

<script>
function chooseService(name, element) {
  document.querySelectorAll('.service').forEach(function(card) {
    card.classList.remove('selected');
  });

  element.classList.add('selected');
  document.getElementById('service').value = name;

  document.getElementById('booking').scrollIntoView({
    behavior: 'smooth'
  });
}

function showDemoMessage(event) {
  event.preventDefault();

  document.getElementById('message').textContent =
    'This is a demo only. Real booking will be enabled after database setup.';
}
</script>

</body>
</html>
